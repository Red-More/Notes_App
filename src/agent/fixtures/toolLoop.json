        { "role": "assistant", "content": "", "toolCalls": 1, "stopReason": "toolUse" },
        {
          "role": "tool",
          "toolCallId": "call_1",
          "toolName": "fs_read",
          "text": "path: /life/agent/draft.md\nrev: 1\ntotalLines: 1\n\n第一行",
