            {
              "id": "call_1",
              "name": "fs_read",
              "arguments": { "path": "/life/agent/draft.md" }
            }
          ]
        },
        {
          "text": "草稿写着：第一行。",
          "stopReason": "stop",
          "calls": []
        }
      ],
      "results": [
        {
          "id": "call_1",
          "name": "fs_read",
          "text": "path: /life/agent/draft.md\nrev: 1\ntotalLines: 1\n\n第一行",
          "isError": false
